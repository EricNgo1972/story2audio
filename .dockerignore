# Keep the build context small and keep host-local state out of the image.
# Note what is deliberately NOT ignored: pyproject.toml, uv.lock and README.md (the builder stage
# copies all three), and docker-entrypoint.sh.

.git
.github
.gitignore
.dockerignore

# Host virtualenv — the image builds its own at /app/.venv.
.venv
__pycache__/
*.py[cod]
*.egg-info
build/
dist/
wheels/

# /app/audio_cache is a symlink to the tenant volume; a local cache dir in the context would be
# copied straight through it and baked into the image.
audio_cache/

# Secrets. The provisioner injects PROXY et al. as environment variables.
.env
.env.*
!.env.example

# Not needed at runtime.
test_*.py
patch_chunking.py
CONTRIBUTING.md
RELEASE_NOTES.md
docker-compose.yml
DEPLOY.md
.vs/
.idea/
.vscode/
